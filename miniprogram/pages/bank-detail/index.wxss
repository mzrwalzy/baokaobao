.bank-detail-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 180rpx;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #17324D 0%, #2F6666 100%);
  padding: 28rpx 30rpx 26rpx;
  padding-top: calc(constant(safe-area-inset-top) + 60rpx);
  padding-top: calc(env(safe-area-inset-top) + 60rpx);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.header-title {
  flex: 1;
  margin: 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-btn {
  min-width: 112rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 26rpx;
  line-height: 72rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.content {
  padding: 238rpx 30rpx 30rpx;
}

.bank-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx;
  background: linear-gradient(135deg, #17324D 0%, #2F6666 100%);
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 14rpx 40rpx rgba(23, 50, 77, 0.18);
}

.bank-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.bank-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.bank-price {
  margin-bottom: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 24rpx;
}

.bank-access-badge {
  margin-bottom: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.bank-access-badge.success {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.bank-access-badge.warning {
  background: rgba(255, 243, 205, 0.18);
  color: #fff6d5;
}

.bank-access-badge.neutral {
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.92);
}

.bank-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.bank-access-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.mode-item {
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s;
}

.mode-item.active {
  background: linear-gradient(135deg, #17324D 0%, #2F6666 100%);
}

.mode-item.active .mode-name {
  color: #fff;
}

.mode-icon {
  font-size: 48rpx;
}

.mode-name {
  font-size: 28rpx;
  color: #666;
}

.start-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.btn-start {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #17324D 0%, #2F6666 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-start::after {
  border: none;
}
