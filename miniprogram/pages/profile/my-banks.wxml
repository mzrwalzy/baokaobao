<view class="header">
  <view class="header-top">
    <view class="back-btn" bindtap="goBack">‹</view>
    <text class="header-title">已购买题库</text>
    <view class="header-placeholder"></view>
  </view>
</view>

<view class="record-page with-fixed-header">
  <view wx:if="{{list.length == 0 && !loading}}" class="empty-card">
    <view class="empty-icon">⭐</view>
    <view class="empty-title">暂无已购买题库</view>
    <view class="empty-text">开通题库后，就能从这里快速进入。</view>
  </view>

  <view class="record-list">
    <view class="record-card bank-card" wx:for="{{list}}" wx:key="id" bindtap="goBank" data-id="{{item.id}}">
      <view class="cover">
        <image wx:if="{{item.cover_image_url}}" src="{{item.cover_image_url}}" mode="aspectFill" />
        <text wx:else>📚</text>
      </view>
      <view class="bank-info">
        <view class="bank-name">{{item.name}}</view>
        <view class="bank-desc">{{item.description || '暂无简介'}}</view>
        <view class="meta-row">
          <text class="meta-chip">{{item.question_num || 0}} 题</text>
          <text class="meta-chip">已开通</text>
          <text class="meta-chip">¥{{item.price_text}}</text>
        </view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
</view>
