@import "./common.wxss";

.settings-list {
  margin-top: 24rpx;
}

.settings-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(17, 37, 54, 0.08);
}

.settings-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D36;
  margin-bottom: 24rpx;
}

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-label {
  font-size: 30rpx;
  color: #333;
}

.settings-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.settings-value {
  font-size: 28rpx;
  color: #999;
}

.switch-wrap {
  display: flex;
  align-items: center;
}

.btn-clear {
  width: 100%;
  height: 88rpx;
  margin-top: 30rpx;
  background: #fff;
  color: #F56C6C;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-clear::after {
  border: none;
}

.version-info {
  margin-top: 60rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}
