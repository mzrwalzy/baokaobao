@import "./common.wxss";

.feedback-form {
  margin-top: 24rpx;
}

.form-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(17, 37, 54, 0.08);
}

.form-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2D36;
  margin-bottom: 20rpx;
  display: block;
}

.type-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-option {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #F7F9F8;
  color: #5F6B73;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.type-option.active {
  background: rgba(47, 102, 102, 0.12);
  color: #2F6666;
  border-color: #2F6666;
  font-weight: 600;
}

.form-textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  background: #F7F9F8;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F7F9F8;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  margin-top: 40rpx;
  background: linear-gradient(135deg, #17324D 0%, #2F6666 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-submit::after {
  border: none;
}

.btn-submit.disabled {
  opacity: 0.5;
}
