<view class="header">
  <view class="header-top">
    <view class="back-btn" bindtap="goBack">‹</view>
    <text class="header-title">考试记录</text>
    <view class="header-placeholder"></view>
  </view>
</view>

<view class="record-page with-fixed-header">
  <view wx:if="{{list.length == 0 && !loading}}" class="empty-card">
    <view class="empty-icon">🧾</view>
    <view class="empty-title">暂无考试记录</view>
    <view class="empty-text">进入考试模式并交卷后，这里会出现记录。</view>
  </view>

  <view class="record-list">
    <view class="record-card" wx:for="{{list}}" wx:key="id">
      <view class="card-topline">
        <view>
          <view class="bank-name">{{item.bank_name}}</view>
          <view class="muted">{{item.submitted_at_text}}</view>
        </view>
        <view class="score-badge">{{item.total_score}}</view>
      </view>
      <view class="stats-row">
        <view class="stat">
          <view class="stat-value">{{item.correct_count}}/{{item.total_question}}</view>
          <view class="stat-label">答对</view>
        </view>
        <view class="stat">
          <view class="stat-value">{{item.correct_rate_text}}%</view>
          <view class="stat-label">正确率</view>
        </view>
        <view class="stat">
          <view class="stat-value">{{item.duration_text}}</view>
          <view class="stat-label">用时</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{finished && list.length > 0}}" class="loading">没有更多了</view>
</view>
