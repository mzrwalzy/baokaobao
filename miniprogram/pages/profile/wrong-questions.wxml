<view class="header">
  <view class="header-top">
    <view class="back-btn" bindtap="goBack">‹</view>
    <text class="header-title">错题本</text>
    <view class="header-placeholder"></view>
  </view>
</view>

<view class="record-page with-fixed-header">
  <view wx:if="{{list.length == 0 && !loading}}" class="empty-card">
    <view class="empty-icon">✓</view>
    <view class="empty-title">暂无错题</view>
    <view class="empty-text">保持这个状态，很漂亮。</view>
  </view>

  <view class="record-list">
    <view class="record-card" wx:for="{{list}}" wx:key="id">
      <view class="card-topline">
        <text class="pill danger">错题</text>
        <text class="muted">{{item.added_at_text}}</text>
      </view>
      <view class="question-title">{{item.title}}</view>
      <view class="question-content">{{item.content}}</view>
      <view class="info-panel">
        <view class="info-label">正确答案</view>
        <view class="info-value">{{item.answer || '暂无答案'}}</view>
      </view>
      <view class="analysis-block">
        <view class="analysis-label">题目解析</view>
        <view class="analysis">{{item.analysis}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{finished && list.length > 0}}" class="loading">没有更多了</view>
</view>
