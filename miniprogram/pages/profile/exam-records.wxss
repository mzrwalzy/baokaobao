@import "./common.wxss";

.card-topline {
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.bank-name + .muted {
  margin-top: 8rpx;
}

.score-badge {
  min-width: 96rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 36rpx;
  background: #2F6666;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat {
  padding: 18rpx 10rpx;
  border-radius: 20rpx;
  background: #F7F9F8;
  text-align: center;
}

.stat-value {
  color: #1F2D36;
  font-size: 26rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: #8A969C;
  font-size: 22rpx;
}
