# BaokaoBao Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
BAOKAOBAO_DATABASE_HOST=localhost
BAOKAOBAO_DATABASE_PORT=3306
BAOKAOBAO_DATABASE_USERNAME=baokaobao
BAOKAOBAO_DATABASE_PASSWORD=your_db_password
BAOKAOBAO_DATABASE_NAME=baokaobao

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# SECURITY WARNING: The JWT secret MUST meet these requirements:
#   - MUST be at least 32 characters
#   - MUST be randomly generated (e.g., openssl rand -base64 32)
#   - MUST be different in every environment (development, staging, production)
#   - NEVER use this example value in production — generate a new one!
#
# Generate a new secret with: openssl rand -base64 32
BAOKAOBAO_JWT_SECRET=4hI/X/Fnr5S+4Pxv4lNvoFiN2pXgOpolYIMEOfyGFV4=

# =============================================================================
# WECHAT MINIPROGRAM CONFIGURATION (SECRETS - DO NOT COMMIT REAL VALUES)
# =============================================================================
BAOKAOBAO_WECHAT_APPID=your_wechat_appid
BAOKAOBAO_WECHAT_SECRET=your_wechat_secret

# =============================================================================
# ALI OSS CONFIGURATION (SECRETS - DO NOT COMMIT REAL VALUES)
# =============================================================================
BAOKAOBAO_OSS_ACCESS_KEY_ID=your_oss_access_key_id
BAOKAOBAO_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
BAOKAOBAO_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
BAOKAOBAO_OSS_BUCKET=your_oss_bucket

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
BAOKAOBAO_APP_MODE=debug
BAOKAOBAO_APP_PORT=10002
