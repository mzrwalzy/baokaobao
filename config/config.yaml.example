app:
  name: "baokaobao"
  host: "0.0.0.0"
  port: 10002
  mode: "debug"

database:
  host: "localhost"
  port: 3306
  username: "baokaobao"
  password: "your_db_password"
  name: "baokaobao"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600

jwt:
  # SECURITY: This MUST be overridden with env var BAOKAOBAO_JWT_SECRET in each environment
  # The secret must be at least 32 characters and randomly generated
  secret: ""
  expire_hours: 720

wechat:
  appid: "your_wechat_appid"
  secret: "your_wechat_secret"

oss:
  endpoint: "oss-cn-shanghai.aliyuncs.com"
  access_key_id: "your_oss_access_key_id"
  access_key_secret: "your_oss_access_key_secret"
  bucket: "your_oss_bucket"

log:
  level: "debug"
  path: "./logs"
  max_size: 100
  max_backups: 30
